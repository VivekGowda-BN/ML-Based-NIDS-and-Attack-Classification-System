# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ─── Distribution / packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ─── Unit test / coverage ─────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ─── Jupyter Notebooks ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Data files (never commit raw/processed data to git) ──────────────────────
data/raw/
data/interim/
data/processed/
data/scenarios/
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/scenarios/.gitkeep

# ─── Trained model artefacts ──────────────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
!models/README.md

# ─── Reports / generated outputs ──────────────────────────────────────────────
reports/figures/*.png
reports/figures/*.svg
reports/metrics/*.json
reports/metrics/*.csv
reports/explanations/*.html

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Streamlit ────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ─── MLflow / experiment tracking ─────────────────────────────────────────────
mlruns/
mlartifacts/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
